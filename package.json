{
  "name": "elmino",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "description": "可复用的 Agent 开发框架",
  "engines": {
    "node": ">=24.18.1 <25",
    "pnpm": "11.18.0"
  },
  "scripts": {
    "lint": "eslint --cache .",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "spellcheck": "cspell lint --config cspell.json --gitignore --no-progress '**/*.{cjs,js,json,jsonc,jsx,md,mjs,ts,tsx,yaml,yml}'",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "pack:packages": "pnpm --filter '@elmino/*' -r pack --pack-destination ./dist/packs",
    "verify:packages": "pnpm pack:packages && node tests/runner/run.mjs",
    "example:basic-agent": "turbo run build --filter=@example/basic-agent... && pnpm --filter @example/basic-agent start",
    "example:full-agent": "turbo run build --filter=@example/full-agent... && pnpm --filter @example/full-agent start",
    "example:server": "turbo run build --filter=@example/server... && pnpm --filter @example/server start",
    "example:sdk": "turbo run build --filter=@example/sdk... && pnpm --filter @example/sdk start",
    "example:agent-engine": "turbo run build --filter=@example/agent-engine... && pnpm --filter @example/agent-engine start",
    "example:agent-hooks": "turbo run build --filter=@example/agent-hooks... && pnpm --filter @example/agent-hooks start",
    "example:turn-control": "turbo run build --filter=@example/turn-control... && pnpm --filter @example/turn-control start",
    "example:subagents": "turbo run build --filter=@example/subagents... && pnpm --filter @example/subagents start",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/node": "catalog:",
    "@violetflux/eslint-config-harness": "catalog:",
    "cspell": "catalog:",
    "eslint": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,jsx,tsx}": "eslint --cache --fix"
  }
}
