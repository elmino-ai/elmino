{
  "name": "elmino",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "description": "可复用的 Agent 开发框架",
  "engines": {
    "node": ">=24.18.1 <25",
    "pnpm": "11.18.0"
  },
  "scripts": {
    "lint": "eslint --cache .",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "spellcheck": "cspell lint --config cspell.json --gitignore --no-progress '**/*.{cjs,js,json,jsonc,jsx,md,mjs,ts,tsx,yaml,yml}'",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "pack:packages": "pnpm --filter '@elmino/*' -r pack --pack-destination ./dist/packs",
    "verify:packages": "pnpm pack:packages && node tests/runner/run.mjs",
    "example:01-basic-agent": "turbo run build --filter=@example/01-basic-agent... && pnpm --filter @example/01-basic-agent start",
    "example:02-full-agent": "turbo run build --filter=@example/02-full-agent... && pnpm --filter @example/02-full-agent start",
    "example:03-server-sdk": "turbo run build --filter=@example/03-server-sdk... && pnpm --filter @example/03-server-sdk start",
    "example:03-server-sdk:client": "turbo run build --filter=@example/03-server-sdk... && pnpm --filter @example/03-server-sdk client",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/node": "catalog:",
    "@violetflux/eslint-config-harness": "catalog:",
    "cspell": "catalog:",
    "eslint": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,jsx,tsx}": "eslint --cache --fix"
  }
}
