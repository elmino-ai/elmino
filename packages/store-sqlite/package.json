{
  "name": "@elmino/store-sqlite",
  "type": "module",
  "version": "0.0.0",
  "description": "基于 Node.js SQLite 的 Agent 运行记录持久化",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "drizzle/runtime/migrations",
    "src"
  ],
  "engines": {
    "node": ">=24.18.1"
  },
  "scripts": {
    "build": "tsdown --config ../../tsdown.config.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "test": "vitest run",
    "db:check": "node --import=tsx scripts/migrations.ts check",
    "db:generate": "node --import=tsx scripts/migrations.ts generate"
  },
  "dependencies": {
    "@elmino/schema": "workspace:^",
    "@elmino/shared": "workspace:*",
    "@elmino/store": "workspace:*",
    "@t3-oss/env-core": "catalog:",
    "dayjs": "catalog:",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "drizzle-kit": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
