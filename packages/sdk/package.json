{
  "name": "@elmino/sdk",
  "type": "module",
  "version": "0.0.0",
  "description": "浏览器与 Node.js 的类型化 Agent API 客户端和事件订阅",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./query": {
      "types": "./dist/query/index.d.ts",
      "import": "./dist/query/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=24.18.1"
  },
  "scripts": {
    "build": "tsdown --config ../../tsdown.config.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@orpc/tanstack-query": "catalog:",
    "@tanstack/query-core": "catalog:",
    "react": "catalog:"
  },
  "peerDependenciesMeta": {
    "@orpc/tanstack-query": {
      "optional": true
    },
    "@tanstack/query-core": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@elmino/api": "workspace:^",
    "@elmino/protocol": "workspace:^",
    "@elmino/request": "workspace:^",
    "@elmino/shared": "workspace:^",
    "@elmino/store": "workspace:^",
    "@elmino/thread": "workspace:^",
    "@elmino/tool": "workspace:^",
    "@opentelemetry/api": "catalog:",
    "@orpc/client": "catalog:"
  },
  "devDependencies": {
    "@orpc/tanstack-query": "catalog:",
    "@tanstack/query-core": "catalog:",
    "@types/react": "catalog:",
    "@types/react-test-renderer": "catalog:",
    "react": "catalog:",
    "react-test-renderer": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
