    "@elmino/local": "workspace:^",
    "@elmino/runtime": "workspace:^",
    "@elmino/sandbox-local": "workspace:^",
    "@elmino/schema": "workspace:^",
    "@elmino/shared": "workspace:^",
    "@elmino/store-sqlite": "workspace:^",
    "@elmino/tool": "workspace:^",
    "@t3-oss/env-core": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
