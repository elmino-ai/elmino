{
  "name": "@example/server-sdk",
  "type": "module",
  "private": true,
  "description": "常驻 Server 与独立 SDK 客户端的远程调用教程",
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "client": "node --env-file-if-exists=.env --import tsx src/client/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@elmino/agent": "workspace:^",
    "@elmino/api": "workspace:^",
    "@elmino/llm": "workspace:^",
    "@elmino/llm-anthropic": "workspace:^",
    "@elmino/local": "workspace:^",
    "@elmino/protocol": "workspace:^",
    "@elmino/runtime": "workspace:^",
    "@elmino/sandbox-local": "workspace:^",
    "@elmino/sdk": "workspace:^",
    "@elmino/server": "workspace:^",
    "@elmino/shared": "workspace:^",
    "@elmino/store": "workspace:^",
    "@elmino/store-sqlite": "workspace:^",
    "@elmino/thread": "workspace:^",
    "@elmino/tool": "workspace:^",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
