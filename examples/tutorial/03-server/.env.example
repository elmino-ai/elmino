# 真实模型调用必填；只由服务端模型入口读取
DEEPSEEK_API_KEY=
# 以下配置都可省略，留空时采用各入口默认值
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
# 可选，填写后 Server 和客户端自动使用同一访问凭据
ELMINO_SERVER_KEY=
ELMINO_HOST=127.0.0.1
ELMINO_PORT=3000
# 可选，SQLite 默认为当前启动目录下的 .elmino
ELMINO_DATA_DIR=
# 可选，未配置则不开放浏览器跨域；此处示范本地前端来源
ELMINO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
